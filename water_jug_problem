#include <stdio.h>

int gcd(int a, int b) {
    if (b == 0)
        return a;
    return gcd(b, a % b);
}

void pour(int fromCap, int toCap, int d) {
    int from = fromCap;
    int to = 0;

    printf("(%d, %d)\n", from, to);

    while (from != d && to != d) {
        int temp = (from < (toCap - to)) ? from : (toCap - to);
        to += temp;
        from -= temp;

        printf("(%d, %d)\n", from, to);

        if (from == d || to == d)
            break;

        if (from == 0) {
            from = fromCap;
            printf("(%d, %d)\n", from, to);
        }

        if (to == toCap) {
            to = 0;
            printf("(%d, %d)\n", from, to);
        }
    }
}

int main() {
    int jug1, jug2, target;

    printf("Enter capacity of Jug 1: ");
    scanf("%d", &jug1);

    printf("Enter capacity of Jug 2: ");
    scanf("%d", &jug2);

    printf("Enter target amount: ");
    scanf("%d", &target);

    if (target > jug1 && target > jug2) {
        printf("Target cannot be measured.\n");
        return 0;
    }

    if (target % gcd(jug1, jug2) != 0) {
        printf("Target cannot be measured.\n");
        return 0;
    }

    printf("\nSteps:\n");
    pour(jug1, jug2, target);

    return 0;
}
